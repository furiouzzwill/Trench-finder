# Set these in Vercel: Project → Settings → Environment Variables. (For local testing, copy to .env.local.)

# Required ─────────────────────────────────────────────────────────────────
# Vercel sends this with the daily scan so nobody else can trigger it. Any random 16+ characters.
CRON_SECRET=
# You type this once on your phone to use the buttons ("I bought this", "Run first scan").
APP_PASSCODE=

# Phone alerts (pick one or both) ─────────────────────────────────────────
# ntfy: install the free "ntfy" app, subscribe to a topic, put the same topic name here.
# Make it long and random, e.g. will-shortlist-8f3k2q9x (anyone who knows the name can read it).
NTFY_TOPIC=
# Discord: channel → Edit → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# Your plan ────────────────────────────────────────────────────────────────
# Your yearly moonshot amount in USD, shown at the top as a reminder. 0 = don't show a number.
MOONSHOT_BUDGET_USD=0
# When a coin you hold is up this many times, you get a "take your original money out" ping.
TAKE_OUT_MULTIPLE=3

# Optional ─────────────────────────────────────────────────────────────────
# Free key from developers.jup.ag makes the scan faster.
JUPITER_API_KEY=
# Only if you created a PUBLIC Blob store instead of private.
# BLOB_ACCESS=public
# Time zone used for "Updated ..." on the page.
# TZ_DISPLAY=America/New_York

# Scan checks (defaults shown) ─────────────────────────────────────────────
# SCAN_MIN_AGE_DAYS=7
# SCAN_MAX_AGE_DAYS=180
# SCAN_MIN_MCAP_USD=250000
# SCAN_MAX_MCAP_USD=25000000
# SCAN_MIN_LIQUIDITY_USD=40000
# SCAN_MIN_LIQ_TO_MCAP_PCT=5
# SCAN_MIN_HOLDERS=1000
# SCAN_MAX_TOP_HOLDERS_PCT=30
# SCAN_MAX_DEV_PCT=10
# SCAN_MIN_ORGANIC_SCORE=20
# SCAN_MAX_RUG_RISK=60
# SCAN_MAX_VOLUME_PER_TRADER_USD=15000
# SCAN_MAX_HOLDER_DROP_PCT=25
# SCAN_TREND_DAYS=7
# SCAN_SHORTLIST_SIZE=15
